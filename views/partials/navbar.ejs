<nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Logo -->
            <a 
                href="<%= locals.user && locals.user.role === 'admin' ? '/admin/dashboard' : '/' %>" 
                class="flex items-center space-x-2 text-xl font-bold text-indigo-600 hover:text-indigo-700"
            >
                <i class="fas fa-calendar-check"></i>
                <span>Smart Events</span>
            </a>

            <!-- Desktop search -->
            <div class="hidden md:flex flex-1 mx-8 max-w-md">
                <form action="/" method="GET" class="w-full relative">
                    <input type="text" name="q" placeholder="Search events..."
                        class="w-full pl-4 pr-12 py-2 border border-gray-300 rounded-lg focus:outline-none 
                               focus:ring-2 focus:ring-indigo-500 text-sm"
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                    <button type="submit" class="absolute right-0 top-0 h-full px-4 text-gray-400 flex items-center justify-center">
                        <i class="fas fa-search text-sm"></i>
                    </button>
                </form>
            </div>

            <!-- Nav links -->
            <div class="flex items-center space-x-4">
                <% if (locals.user) { %>
                    <% if (locals.user.role === 'admin') { %>
                        <a href="/admin/dashboard" class="text-gray-700 hover:text-indigo-600 text-sm font-medium hidden sm:block">
                            <i class="fas fa-chart-line mr-1"></i>Dashboard
                        </a>
                        <a href="/admin/events" class="text-gray-700 hover:text-indigo-600 text-sm font-medium hidden sm:block">
                            <i class="fas fa-calendar-alt mr-1"></i>Events
                        </a>
                        <a href="/contact/admin" class="text-gray-700 hover:text-indigo-600 text-sm font-medium hidden sm:block">
                            <i class="fas fa-envelope mr-1"></i>Enquiries
                        </a>
                    <% } else { %>
                        <a href="/" class="text-gray-700 hover:text-indigo-600 text-sm font-medium hidden sm:block">
                            <i class="fas fa-home mr-1"></i>Home
                        </a>
                        <a href="/bookings/my-bookings" class="text-gray-700 hover:text-indigo-600 text-sm font-medium hidden sm:block">
                            <i class="fas fa-ticket-alt mr-1"></i>My Bookings
                        </a>
                        <a href="/contact" class="text-gray-700 hover:text-indigo-600 text-sm font-medium hidden sm:block">
                            <i class="fas fa-envelope mr-1"></i>Contact Admin
                        </a>
                    <% } %>

                    <!-- User dropdown -->
                    <div class="relative group">
                        <button class="flex items-center gap-2 text-gray-700 hover:text-indigo-600 text-sm font-medium">
                            <i class="fas fa-user-circle text-xl"></i>
                            <span class="hidden sm:inline"><%= locals.user.name.split(' ')[0] %></span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        <div class="absolute right-0 mt-1 w-44 bg-white rounded-lg shadow-lg border border-gray-200
                                    opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                                    
                            <a href="/auth/logout" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-red-600">
                                <i class="fas fa-sign-out-alt mr-2"></i>Logout
                            </a>
                        </div>
                    </div>

                <% } else { %>
                    <a 
                        href="/auth/login" 
                        class="text-gray-700 hover:text-indigo-600 text-sm font-medium">
                        <i class="fas fa-sign-in-alt mr-1"></i><span class="hidden sm:inline">Login</span>
                    </a>
                    <a 
                        href="/auth/register" 
                        class="bg-indigo-600 text-white px-3 py-2 rounded-lg text-sm font-medium 
                        hover:bg-indigo-700 hover:text-white hover:shadow-md hover:-translate-y-0.5 
                        transition-all duration-200">
                        <i class="fas fa-user-plus mr-1"></i>
                        <span class="hidden sm:inline">Register</span>
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</nav>
