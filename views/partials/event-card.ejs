<div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow overflow-hidden flex flex-col h-full">

    <!-- Image -->
    <div class="relative h-48 bg-gray-200 overflow-hidden">
        <img
            src="<%= event.imageUrl || '/images/placeholders/event-placeholder.jpg' %>"
            alt="<%= event.title %>"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            onerror="this.src='https://placehold.co/600x400/E0E7FF/4F46E5?text=Event'"
        >
        <div class="absolute top-3 right-3">
            <span class="px-2 py-1 bg-indigo-600 text-white text-xs font-semibold rounded-full capitalize">
                <%= event.category || 'Event' %>
            </span>
        </div>
    </div>

    <!-- Content -->
    <div class="p-4 flex flex-col flex-grow">
        <h3 class="text-base font-semibold text-gray-900 mb-2 line-clamp-2">
            <a href="/events/<%= event._id %>" class="hover:text-indigo-600 transition-colors">
                <%= event.title %>
            </a>
        </h3>
        <div class="space-y-1.5 text-sm text-gray-600 mb-3">
            <div class="flex items-center gap-2">
                <i class="fas fa-calendar-alt text-indigo-500 w-4 flex-shrink-0"></i>
                <span>
                    <%= new Date(event.date).toLocaleDateString('en-ZA', { day:'numeric', month:'short', year:'numeric' }) %>
                </span>
            </div>

            <% if (event.location) { %>
            <div class="flex items-center gap-2">
                <i class="fas fa-map-marker-alt text-indigo-500 w-4 flex-shrink-0"></i>
                <span class="truncate"><%= event.location %></span>
            </div>
            <% } %>
        </div>

        <!-- Availability -->
        <div class="mt-auto mb-4">
            <%
                const avail = event.ticketsAvailable;
                const pct = event.capacity > 0 ? Math.max(0, (avail / event.capacity) * 100) : 0;
            %>
            <div class="flex justify-between text-xs text-gray-500 mb-1">
                <span>Availability</span>
                <span class="<%= avail > 0 ? 'text-green-600' : 'text-red-600' %> font-semibold">
                    <%= avail > 0 ? avail + ' left' : 'Sold Out' %>
                </span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-1.5">
                <div class="<%= avail > 0 ? 'bg-indigo-500' : 'bg-red-500' %> h-1.5 rounded-full"
                     style="width:<%= pct %>%"></div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="flex gap-2 pt-3 border-t border-gray-100">
            <!-- View -->
            <a
                href="/events/<%= event._id %>"
                class="flex-1 bg-indigo-100 text-indigo-700 py-2 rounded-lg text-center text-sm font-medium
                       hover:bg-indigo-200 hover:shadow-md hover:-translate-y-0.5
                       transition-all duration-200 pt-3" 
            >
                <i class="fas fa-eye mr-1"></i>View
            </a>`

            <!-- Book -->
            <% if (avail > 0) { %>
                <form action="/bookings/<%= event._id %>" method="POST" class="flex-1">
                    <button
                        type="submit"
                        class="w-full bg-indigo-600 text-white py-2 rounded-lg text-sm 
                               font-medium hover:bg-indigo-700 transition-colors"
                    >
                        <i class="fas fa-ticket-alt mr-1"></i>Book
                    </button>
                </form>
            <% } else { %>
                <button
                    disabled
                    class="flex-1 bg-gray-200 text-gray-500 py-2 rounded-lg text-sm font-medium cursor-not-allowed"
                >
                    Sold Out
                </button>
            <% } %>
        </div>
    </div>
</div>