<!-- Event Card Partial -->
<!-- Usage: <%- include('../partials/event-card', { event: eventObject }) %> -->

<div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow overflow-hidden h-full flex flex-col">
    
    <!-- Event Image -->
    <div class="relative h-48 bg-gray-200 overflow-hidden">
        <img 
            src="<%= event.imageUrl || '/images/placeholders/event-placeholder.jpg' %>"
            alt="<%= event.title %>"
            class="w-full h-full object-cover hover:scale-110 transition-transform duration-300"
        >
        
        <!-- Category Badge -->
        <div class="absolute top-3 right-3">
            <span class="inline-block px-3 py-1 bg-indigo-600 text-white text-xs font-semibold rounded-full">
                <%= event.category || 'Event' %>
            </span>
        </div>
        
        <!-- Status Badge (if applicable) -->
        <% if (event.status === 'featured') { %>
            <div class="absolute top-3 left-3">
                <span class="inline-block px-3 py-1 bg-amber-500 text-white text-xs font-semibold rounded-full">
                    <i class="fas fa-star mr-1"></i>Featured
                </span>
            </div>
        <% } %>
    </div>
    
    <!-- Event Content -->
    <div class="p-4 flex-grow flex flex-col">
        
        <!-- Title -->
        <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2 hover:text-indigo-600 transition-colors">
            <%= event.title %>
        </h3>
        
        <!-- Event Info Grid -->
        <div class="space-y-2 text-sm text-gray-600 mb-4">
            
            <!-- Date & Time -->
            <div class="flex items-start space-x-2">
                <i class="fas fa-calendar-alt text-indigo-600 mt-0.5 flex-shrink-0"></i>
                <div>
                    <div><%= new Date(event.date).toLocaleDateString('en-ZA', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                    <div class="text-xs text-gray-500"><%= new Date(event.date).toLocaleTimeString('en-ZA', { hour: '2-digit', minute: '2-digit' }) %></div>
                </div>
            </div>
            
            <!-- Location -->
            <div class="flex items-start space-x-2">
                <i class="fas fa-map-marker-alt text-indigo-600 mt-0.5 flex-shrink-0"></i>
                <span class="line-clamp-1"><%= event.location %></span>
            </div>
            
            <!-- Organizer -->
            <% if (event.organizer) { %>
                <div class="flex items-start space-x-2">
                    <i class="fas fa-user-tie text-indigo-600 mt-0.5 flex-shrink-0"></i>
                    <span class="line-clamp-1"><%= event.organizer %></span>
                </div>
            <% } %>
        </div>
        
        <!-- Availability Section -->
        <div class="mb-4 mt-auto">
            <div class="flex justify-between items-center text-sm mb-2">
                <span class="font-medium text-gray-700">Availability</span>
                <span class="<%= event.availableTickets > 0 ? 'text-green-600 font-semibold' : 'text-red-600 font-semibold' %>">
                    <% if (event.availableTickets > 0) { %>
                        <%= event.availableTickets %> / <%= event.capacity %>
                    <% } else { %>
                        Sold Out
                    <% } %>
                </span>
            </div>
            
            <!-- Progress Bar -->
            <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                <div 
                    class="<%= event.availableTickets > 0 ? 'bg-indigo-600' : 'bg-red-600' %> h-2 rounded-full transition-all"
                    style="width: <%= (event.availableTickets / event.capacity) * 100 %>%"
                ></div>
            </div>
            
            <!-- Ticket Count Info -->
            <p class="text-xs text-gray-500 mt-1">
                <%= event.capacity - event.availableTickets %> booked • <%= event.availableTickets %> remaining
            </p>
        </div>
        
        <!-- Price (if applicable) -->
        <% if (event.price && event.price > 0) { %>
            <div class="mb-4">
                <span class="text-2xl font-bold text-indigo-600">
                    R<%= event.price.toFixed(2) %>
                </span>
                <span class="text-sm text-gray-600"> per ticket</span>
            </div>
        <% } else if (event.price === 0) { %>
            <div class="mb-4">
                <span class="text-xl font-bold text-green-600">
                    FREE
                </span>
            </div>
        <% } %>
        
        <!-- Actions -->
        <div class="flex gap-2 pt-4 border-t border-gray-200">
            <a 
                href="/events/<%= event._id %>"
                class="flex-1 bg-indigo-600 text-white py-2 rounded-lg font-medium hover:bg-indigo-700 transition-colors text-center text-sm"
            >
                <i class="fas fa-eye mr-1"></i>View Details
            </a>
            
            <% if (event.availableTickets > 0) { %>
                <a 
                    href="/events/<%= event._id %>/book"
                    class="flex-1 bg-teal-600 text-white py-2 rounded-lg font-medium hover:bg-teal-700 transition-colors text-center text-sm"
                    title="Book this event"
                >
                    <i class="fas fa-ticket-alt mr-1"></i>Book
                </a>
            <% } else { %>
                <button 
                    class="flex-1 bg-gray-300 text-gray-600 py-2 rounded-lg font-medium cursor-not-allowed text-sm"
                    disabled
                    title="No tickets available"
                >
                    <i class="fas fa-ban mr-1"></i>Sold Out
                </button>
            <% } %>
        </div>
    </div>
</div>
