<!-- Home / Event Listing Page -->

<!-- Hero Section -->
<div class="mb-12">
    <div class="bg-gradient-to-r from-indigo-600 to-indigo-800 rounded-lg p-8 sm:p-12 text-white">
        <h1 class="text-4xl sm:text-5xl font-bold mb-4">Discover Amazing Events</h1>
        <p class="text-lg text-indigo-100 mb-8 max-w-2xl">
            Browse and book tickets to conferences, workshops, festivals, and more. Find the perfect event for you today.
        </p>
        
        <!-- Search Bar in Hero -->
        <form action="/search" method="GET" class="max-w-2xl">
            <div class="flex gap-2">
                <div class="flex-1 relative">
                    <input 
                        type="text"
                        name="q"
                        placeholder="Search events, keywords, locations..."
                        class="w-full px-4 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-white"
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                    >
                </div>
                <button 
                    type="submit"
                    class="bg-teal-600 hover:bg-teal-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors flex items-center gap-2"
                >
                    <i class="fas fa-search"></i>
                    <span class="hidden sm:inline">Search</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Filters Section -->
<div class="mb-8">
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Filter Events</h2>
        
        <form action="/" method="GET" class="space-y-4" id="filterForm">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                
                <!-- Category Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Category
                    </label>
                    <select 
                        name="category"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        onchange="document.getElementById('filterForm').submit()"
                    >
                        <option value="">All Categories</option>
                        <option value="conference" <% if (typeof filterCategory !== 'undefined' && filterCategory === 'conference') { %>selected<% } %>>Conference</option>
                        <option value="workshop" <% if (typeof filterCategory !== 'undefined' && filterCategory === 'workshop') { %>selected<% } %>>Workshop</option>
                        <option value="festival" <% if (typeof filterCategory !== 'undefined' && filterCategory === 'festival') { %>selected<% } %>>Festival</option>
                        <option value="concert" <% if (typeof filterCategory !== 'undefined' && filterCategory === 'concert') { %>selected<% } %>>Concert</option>
                        <option value="seminar" <% if (typeof filterCategory !== 'undefined' && filterCategory === 'seminar') { %>selected<% } %>>Seminar</option>
                        <option value="networking" <% if (typeof filterCategory !== 'undefined' && filterCategory === 'networking') { %>selected<% } %>>Networking</option>
                        <option value="other" <% if (typeof filterCategory !== 'undefined' && filterCategory === 'other') { %>selected<% } %>>Other</option>
                    </select>
                </div>
                
                <!-- Date Range Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        From Date
                    </label>
                    <input 
                        type="date"
                        name="dateFrom"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        value="<%= typeof filterDateFrom !== 'undefined' ? filterDateFrom : '' %>"
                        onchange="document.getElementById('filterForm').submit()"
                    >
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        To Date
                    </label>
                    <input 
                        type="date"
                        name="dateTo"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        value="<%= typeof filterDateTo !== 'undefined' ? filterDateTo : '' %>"
                        onchange="document.getElementById('filterForm').submit()"
                    >
                </div>
                
                <!-- Location Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Location
                    </label>
                    <input 
                        type="text"
                        name="location"
                        placeholder="City or venue..."
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        value="<%= typeof filterLocation !== 'undefined' ? filterLocation : '' %>"
                    >
                </div>
            </div>
            
            <!-- Filter Actions -->
            <div class="flex gap-2 pt-4 border-t border-gray-200">
                <button 
                    type="submit"
                    class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700 transition-colors flex items-center gap-2"
                >
                    <i class="fas fa-filter"></i>Apply Filters
                </button>
                <a 
                    href="/"
                    class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium hover:bg-gray-300 transition-colors flex items-center gap-2"
                >
                    <i class="fas fa-redo"></i>Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Featured Events Section -->
<% if (typeof featuredEvents !== 'undefined' && featuredEvents.length > 0) { %>
    <div class="mb-12">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-3xl font-bold text-gray-900">Featured Events</h2>
            <a href="/?featured=true" class="text-indigo-600 hover:text-indigo-700 font-semibold">
                View All <i class="fas fa-arrow-right ml-2"></i>
            </a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% featuredEvents.slice(0, 3).forEach(event => { %>
                <%- include('../partials/event-card', { event: event }) %>
            <% }); %>
        </div>
    </div>
<% } %>

<!-- Main Events Section -->
<div>
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-3xl font-bold text-gray-900">All Events</h2>
            <% if (typeof totalEvents !== 'undefined') { %>
                <p class="text-gray-600 text-sm mt-1">
                    Showing <span class="font-semibold"><%= events.length %></span> of <span class="font-semibold"><%= totalEvents %></span> events
                </p>
            <% } %>
        </div>
        
        <!-- Sort Options -->
        <div class="flex gap-2">
            <form method="GET" class="relative">
                <select 
                    name="sort"
                    class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    onchange="this.form.submit()"
                >
                    <option value="newest" <% if (typeof sortBy !== 'undefined' && sortBy === 'newest') { %>selected<% } %>>Newest First</option>
                    <option value="oldest" <% if (typeof sortBy !== 'undefined' && sortBy === 'oldest') { %>selected<% } %>>Oldest First</option>
                    <option value="upcoming" <% if (typeof sortBy !== 'undefined' && sortBy === 'upcoming') { %>selected<% } %>>Coming Soon</option>
                    <option value="popular" <% if (typeof sortBy !== 'undefined' && sortBy === 'popular') { %>selected<% } %>>Most Booked</option>
                </select>
            </form>
        </div>
    </div>
    
    <!-- Events Grid -->
    <% if (typeof events !== 'undefined' && events.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            <% events.forEach(event => { %>
                <%- include('../partials/event-card', { event: event }) %>
            <% }); %>
        </div>
        
        <!-- Pagination -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="flex justify-center items-center gap-2 mt-8">
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === (typeof currentPage !== 'undefined' ? currentPage : 1)) { %>
                        <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium">
                            <%= i %>
                        </button>
                    <% } else { %>
                        <a 
                            href="?page=<%= i %>"
                            class="px-4 py-2 border border-gray-300 rounded-lg font-medium hover:bg-gray-50 transition-colors"
                        >
                            <%= i %>
                        </a>
                    <% } %>
                <% } %>
            </div>
        <% } %>
    <% } else { %>
        <!-- No Events Found -->
        <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
            <i class="fas fa-inbox text-6xl text-gray-400 mb-4"></i>
            <h3 class="text-2xl font-semibold text-gray-900 mb-2">No Events Found</h3>
            <p class="text-gray-600 mb-6">
                We couldn't find any events matching your search criteria. Try adjusting your filters or check back soon for new events.
            </p>
            <a 
                href="/"
                class="inline-block bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700 transition-colors"
            >
                <i class="fas fa-redo mr-2"></i>Clear Filters
            </a>
        </div>
    <% } %>
</div>

<!-- Call to Action Section -->
<div class="mt-16 bg-indigo-50 rounded-lg p-8 border border-indigo-200 text-center">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Ready to Book Your Next Event?</h2>
    <p class="text-gray-600 mb-6">
        <% if (typeof user !== 'undefined' && user) { %>
            Browse our collection of amazing events and book your tickets today.
        <% } else { %>
            Create an account to start booking tickets to amazing events.
        <% } %>
    </p>
    <% if (typeof user === 'undefined' || !user) { %>
        <a 
            href="/register"
            class="inline-block bg-indigo-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition-colors"
        >
            <i class="fas fa-user-plus mr-2"></i>Get Started
        </a>
    <% } %>
</div>
