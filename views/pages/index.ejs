<!-- Hero Section -->
<section class="bg-primary-700 text-white py-16 sm:py-24 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-primary-700 to-primary-500 opacity-90 z-0"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">Discover Amazing Events <br class="hidden md:block">in Your City</h1>
    <p class="text-lg md:text-xl text-primary-100 mb-10 max-w-2xl mx-auto">Book tickets for the best tech conferences, workshops, and networking events happening near you.</p>
    
    <!-- Mobile Search (Visible only on mobile/tablet) -->
    <div class="md:hidden max-w-md mx-auto relative mb-6">
      <input type="text" placeholder="Search events..." class="w-full pl-10 pr-4 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-accent shadow-lg">
      <i class="fas fa-search absolute left-4 top-4 text-gray-400"></i>
    </div>
  </div>
</section>

<!-- Filter & Layout Controls -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20 mb-12">
  <div class="bg-white rounded-xl shadow-md p-4 sm:p-6 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0 border border-gray-100">
    
    <!-- Filters -->
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <select class="form-select bg-gray-50 border border-gray-200 text-gray-700 rounded-lg py-2 pl-3 pr-8 focus:outline-none focus:ring-2 focus:ring-primary text-sm font-medium">
        <option value="">All Categories</option>
        <option value="conference">Conferences</option>
        <option value="workshop">Workshops</option>
        <option value="networking">Networking</option>
      </select>
      
      <select class="form-select bg-gray-50 border border-gray-200 text-gray-700 rounded-lg py-2 pl-3 pr-8 focus:outline-none focus:ring-2 focus:ring-primary text-sm font-medium">
        <option value="">Any Date</option>
        <option value="today">Today</option>
        <option value="this-week">This Week</option>
        <option value="this-month">This Month</option>
      </select>
    </div>

    <!-- Active Results Count -->
    <div class="text-gray-500 text-sm font-medium w-full md:w-auto text-left md:text-right">
      Showing <span class="text-gray-900"><%= typeof events !== 'undefined' ? events.length : 0 %></span> upcoming events
    </div>
  </div>
</section>

<!-- Event Grid Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-20">
  <% if (typeof events !== 'undefined' && events.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="events-grid">
      <% events.forEach(event => { %>
        <%- include('../partials/event-card', { event: event }) %>
      <% }) %>
    </div>
    
    <!-- Pagination (Placeholder) -->
    <div class="mt-12 flex justify-center">
      <nav class="flex items-center space-x-2">
        <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-200 text-gray-500 hover:bg-gray-50 hover:text-primary transition-colors"><i class="fas fa-chevron-left"></i></a>
        <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary text-white font-medium shadow-sm">1</a>
        <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors">2</a>
        <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors">3</a>
        <a href="#" class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-200 text-gray-500 hover:bg-gray-50 hover:text-primary transition-colors"><i class="fas fa-chevron-right"></i></a>
      </nav>
    </div>
    
  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary-50 text-primary mb-6">
        <i class="fas fa-calendar-times text-3xl"></i>
      </div>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">No events found</h3>
      <p class="text-gray-500 max-w-md mx-auto mb-8">We couldn't find any events matching your current filters. Try adjusting your search criteria or check back later.</p>
      <button class="bg-white border-2 border-primary text-primary px-6 py-2 rounded-lg font-medium hover:bg-primary-50 transition-colors">
        Clear All Filters
      </button>
    </div>
  <% } %>
</section>