<!-- Admin Create Event Page -->

<% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>

<div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">
            Create New Event
        </h1>
        <p class="text-gray-600">
            Add a new event to the Smart Events platform.
        </p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
        <!-- Top Banner -->
        <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 px-8 py-6 text-white">
            <h2 class="text-2xl font-bold mb-1">
                Event Details
            </h2>
            <p class="text-indigo-100 text-sm">
                Fill in the information below to create your event.
            </p>
        </div>

        <!-- Form -->
        <form
            action="/admin/events/create"
            method="POST"
            class="p-8 space-y-8"
        >
            <!-- Event Title -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Event Title
                </label>
                <input
                    type="text"
                    name="title"
                    required
                    placeholder="Enter event title"
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl 
                           focus:outline-none focus:ring-2 focus:ring-indigo-500 
                           focus:border-indigo-500 transition-all"
                >
            </div>

            <!-- Description -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Description
                </label>
                <textarea
                    name="description"
                    rows="5"
                    placeholder="Describe your event..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl 
                           focus:outline-none focus:ring-2 focus:ring-indigo-500 
                           focus:border-indigo-500 transition-all resize-none"
                ></textarea>
            </div>

            <!-- Grid Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Category
                    </label>
                    <select
                        name="category"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl 
                               focus:outline-none focus:ring-2 focus:ring-indigo-500 
                               focus:border-indigo-500 transition-all"
                    >
                        <option value="">Select category</option>
                        <option value="conference">Conference</option>
                        <option value="festival">Festival</option>
                        <option value="workshop">Workshop</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <!-- Event Date -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Event Date & Time
                    </label>
                    <input
                        type="datetime-local"
                        name="date"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl 
                               focus:outline-none focus:ring-2 focus:ring-indigo-500 
                               focus:border-indigo-500 transition-all"
                    >
                </div>

                <!-- Location -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Location
                    </label>
                    <input
                        type="text"
                        name="location"
                        placeholder="Enter venue or city"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl 
                               focus:outline-none focus:ring-2 focus:ring-indigo-500 
                               focus:border-indigo-500 transition-all"
                    >
                </div>

                <!-- Capacity -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Event Capacity
                    </label>
                    <input
                        type="number"
                        name="capacity"
                        min="1"
                        required
                        placeholder="Enter total capacity"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl 
                               focus:outline-none focus:ring-2 focus:ring-indigo-500 
                               focus:border-indigo-500 transition-all"
                    >
                </div>

                <!-- Tickets Available -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Tickets Available
                    </label>
                    <input
                        type="number"
                        name="ticketsAvailable"
                        min="0"
                        required
                        placeholder="Enter available tickets"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl 
                               focus:outline-none focus:ring-2 focus:ring-indigo-500 
                               focus:border-indigo-500 transition-all"
                    >
                </div>
            </div>

            <!-- Info Box -->
            <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 flex gap-3 items-start">
                <div class="text-indigo-600 text-xl mt-0.5">
                    <i class="fas fa-circle-info"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-indigo-900 mb-1">
                        Event Creation Tips
                    </h3>
                    <p class="text-sm text-indigo-800 leading-relaxed">
                        Make sure your event details are accurate before publishing. Capacity should reflect the maximum number of attendees your venue can accommodate.
                    </p>
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-gray-200">
                <!-- Submit -->
                <button
                    type="submit"
                    class="flex-1 bg-indigo-600 text-white py-3 rounded-xl font-semibold 
                           hover:bg-indigo-700 hover:shadow-lg 
                           transition-all duration-200 flex items-center justify-center gap-2"
                >
                    <i class="fas fa-plus-circle"></i>
                    Create Event
                </button>

                <!-- Cancel -->
                <a
                    href="/admin/dashboard"
                    class="flex-1 bg-gray-200 text-gray-700 py-3 rounded-xl font-semibold 
                           hover:bg-gray-300 hover:shadow-md transition-all duration-200 
                           flex items-center justify-center gap-2"
                >
                    <i class="fas fa-arrow-left"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<% } else { %>

<!-- Unauthorized -->
<div class="text-center py-16">
    <div class="text-6xl text-gray-300 mb-4">
        <i class="fas fa-lock"></i>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-3">
        Access Denied
    </h1>
    <p class="text-gray-600 mb-6">
        You do not have permission to access this page.
    </p>
    <a
        href="/"
        class="inline-flex items-center gap-2 bg-indigo-600 text-white px-6 py-3 
               rounded-xl font-semibold hover:bg-indigo-700 transition-colors"
    >
        <i class="fas fa-arrow-left"></i>
        Back to Home
    </a>
</div>

<% } %>
