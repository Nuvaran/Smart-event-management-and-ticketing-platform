<!-- Contact / Enquiry Page -->

<% if (typeof userView !== 'undefined' && userView === false) { %>
    <!-- ADMIN VIEW - Manage Enquiries -->
    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <!-- Page Header -->
        <div class="mb-8 flex justify-between items-center">
            <div>
                <h1 class="text-4xl font-bold text-gray-900 mb-2">Contact Enquiries</h1>
                <p class="text-gray-600">Manage user enquiries and respond to messages.</p>
            </div>
        </div>
        
        <!-- Filters -->
        <div class="bg-white rounded-lg shadow p-6 mb-6 border border-gray-200">
            <form method="GET" class="flex gap-4 flex-wrap">
                <select 
                    name="status"
                    class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                >
                    <option value="">All Status</option>
                    <option value="new" <% if (typeof filterStatus !== 'undefined' && filterStatus === 'new') { %>selected<% } %>>New</option>
                    <option value="responded" <% if (typeof filterStatus !== 'undefined' && filterStatus === 'responded') { %>selected<% } %>>Responded</option>
                    <option value="closed" <% if (typeof filterStatus !== 'undefined' && filterStatus === 'closed') { %>selected<% } %>>Closed</option>
                </select>
                <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700 transition-colors">
                    Filter
                </button>
            </form>
        </div>
        
        <!-- Enquiries List -->
        <div class="space-y-4">
            <% if (typeof enquiries !== 'undefined' && enquiries.length > 0) { %>
                <% enquiries.forEach(enquiry => { %>
                    <div class="bg-white rounded-lg shadow border border-gray-200 p-6 hover:shadow-lg transition-shadow">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-xl font-semibold text-gray-900"><%= enquiry.subject %></h3>
                                <p class="text-sm text-gray-600 mt-1">
                                    From: <span class="font-medium"><%= enquiry.name %></span> 
                                    (<%= enquiry.email %>)
                                </p>
                            </div>
                            <% 
                                let statusColor = 'gray';
                                if (enquiry.status === 'new') statusColor = 'blue';
                                if (enquiry.status === 'responded') statusColor = 'green';
                                if (enquiry.status === 'closed') statusColor = 'gray';
                            %>
                            <span class="inline-block px-3 py-1 bg-<%= statusColor %>-100 text-<%= statusColor %>-700 
                                         rounded-full text-sm font-semibold capitalize">
                                <%= enquiry.status %>
                            </span>
                        </div>
                        <div class="mb-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
                            <p class="text-gray-700"><%= enquiry.message %></p>
                        </div>
                        <div class="flex items-center justify-between text-sm text-gray-600 mb-4">
                            <div class="flex gap-4">
                                <span>
                                    <i class="fas fa-phone mr-1"></i>
                                    <%= enquiry.phone %>
                                </span>
                                <span>
                                    <i class="fas fa-calendar mr-1"></i>
                                    <%= new Date(enquiry.createdAt).toLocaleDateString('en-ZA') %>
                                </span>
                            </div>
                        </div>
                        
                        <!-- Actions -->
                        <div class="flex gap-2 pt-4 border-t border-gray-200">
                            <button 
                                class="flex-1 bg-indigo-600 text-white py-2 rounded-lg font-medium hover:bg-indigo-700 transition-colors"
                                onclick="respondToEnquiry('<%= enquiry._id %>')"
                            >
                                <i class="fas fa-reply mr-2"></i>Respond
                            </button>
                            <button 
                                class="flex-1 border border-gray-300 text-gray-700 py-2 rounded-lg font-medium hover:bg-gray-50 transition-colors"
                                onclick="markAsResolved('<%= enquiry._id %>')"
                            >
                                <i class="fas fa-check mr-2"></i>Mark Resolved
                            </button>
                            <button 
                                class="flex-1 border border-red-300 text-red-700 py-2 rounded-lg font-medium hover:bg-red-50 transition-colors"
                                onclick="deleteEnquiry('<%= enquiry._id %>')"
                            >
                                <i class="fas fa-trash mr-2"></i>Delete
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="bg-white rounded-lg shadow p-12 text-center border border-gray-200">
                    <i class="fas fa-inbox text-6xl text-gray-400 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-gray-900 mb-2">No Enquiries</h3>
                    <p class="text-gray-600">All enquiries have been handled. Check back later.</p>
                </div>
            <% } %>
        </div>
        
    <% } else { %>
        <!-- Unauthorized -->
        <div class="text-center py-16">
            <i class="fas fa-lock text-6xl text-gray-400 mb-4"></i>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Access Denied</h1>
            <p class="text-gray-600 mb-6">You don't have permission to access this page.</p>
            <a href="/" class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition-colors">
                <i class="fas fa-arrow-left mr-2"></i>Back to Home
            </a>
        </div>
    <% } %>
    
<% } else { %>
    <!-- User view - Contact Form -->
    
    <!-- Page Header -->
    <div class="mb-12">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">Get in Touch</h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Have a question about an event or need help? We'd love to hear from you. Send us a message and we'll respond as soon as possible.
            </p>
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow p-8 border border-gray-200">
                <!-- Success Message -->
                <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                    <div class="mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-green-500 mt-0.5 mr-3"></i>
                            <div>
                                <h3 class="font-semibold text-green-800 mb-1">Message Sent Successfully!</h3>
                                <p class="text-green-700 text-sm">We'll review your message and get back to you soon.</p>
                            </div>
                        </div>
                    </div>
                <% } %>
                
                <!-- Error Messages -->
                <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
                        <div class="flex items-start">
                            <i class="fas fa-exclamation-circle text-red-500 mt-0.5 mr-3"></i>
                            <div>
                                <h3 class="font-semibold text-red-800 mb-1">Error</h3>
                                <ul class="text-red-700 text-sm space-y-1">
                                    <% errors.forEach(error => { %>
                                        <li>• <%= error %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        </div>
                    </div>
                <% } %>
                
                <form action="/contact" method="POST" class="space-y-6" id="contactForm" novalidate>
                    <!-- Name -->
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                            Full Name *
                        </label>
                        <input 
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Your name"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none 
                                   focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                            required
                            value="<%= typeof name !== 'undefined' ? name : '' %>"
                        >
                        <p class="text-red-500 text-sm mt-1 hidden" id="nameError"></p>
                    </div>
                    
                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                            Email Address *
                        </label>
                        <input 
                            type="email"
                            id="email"
                            name="email"
                            placeholder="your.email@example.com"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none 
                                   focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                            required
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                        >
                        <p class="text-red-500 text-sm mt-1 hidden" id="emailError"></p>
                    </div>
                    
                    <!-- Phone -->
                    <div>
                        <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                            Phone Number *
                        </label>
                        <input 
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="+27 123 456 789"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none 
                                   focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                            required
                            value="<%= typeof phone !== 'undefined' ? phone : '' %>"
                        >
                        <p class="text-red-500 text-sm mt-1 hidden" id="phoneError"></p>
                    </div>
                    
                    <!-- Subject -->
                    <div>
                        <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
                            Subject *
                        </label>
                        <select 
                            id="subject"
                            name="subject"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none 
                                   focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                            required
                        >
                            <option value="">Select a subject</option>
                            <option value="event-inquiry" <% if (typeof subject !== 'undefined' && subject === 'event-inquiry') { %>selected<% } %>>Event Inquiry</option>
                            <option value="booking-issue" <% if (typeof subject !== 'undefined' && subject === 'booking-issue') { %>selected<% } %>>Booking Issue</option>
                            <option value="technical-support" <% if (typeof subject !== 'undefined' && subject === 'technical-support') { %>selected<% } %>>Technical Support</option>
                            <option value="feedback" <% if (typeof subject !== 'undefined' && subject === 'feedback') { %>selected<% } %>>Feedback</option>
                            <option value="other" <% if (typeof subject !== 'undefined' && subject === 'other') { %>selected<% } %>>Other</option>
                        </select>
                        <p class="text-red-500 text-sm mt-1 hidden" id="subjectError"></p>
                    </div>
                    
                    <!-- Message -->
                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
                            Message *
                        </label>
                        <textarea 
                            id="message"
                            name="message"
                            rows="6"
                            placeholder="Tell us more about your inquiry..."
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none 
                                   focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                            required
                        ><%= typeof message !== 'undefined' ? message : '' %></textarea>
                        <p class="text-red-500 text-sm mt-1 hidden" id="messageError"></p>
                    </div>
                    
                    <!-- Privacy Notice -->
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                        <p class="text-sm text-blue-800">
                            <i class="fas fa-info-circle mr-2"></i>
                            Your information is secure and will only be used to respond to your inquiry.
                        </p>
                    </div>
                    
                    <!-- Submit Button -->
                    <button 
                        type="submit"
                        class="w-full bg-indigo-600 text-white py-3 rounded-lg font-semibold hover:bg-indigo-700 
                               transition-colors flex items-center justify-center gap-2"
                        id="submitBtn"
                    >
                        <i class="fas fa-paper-plane"></i>
                        <span id="btnText">Send Message</span>
                        <i class="fas fa-spinner fa-spin ml-2 hidden" id="btnSpinner"></i>
                    </button>
                </form>
            </div>
        </div>
        
        <!-- Contact Information -->
        <div class="lg:col-span-1">
            <!-- Contact Details Card -->
            <div class="bg-white rounded-lg shadow p-6 border border-gray-200 mb-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Contact Information</h2>
                <div class="space-y-6">
                    
                    <!-- Email -->
                    <div class="flex gap-4">
                        <div class="text-indigo-600 text-xl flex-shrink-0 mt-1">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Email</p>
                            <a href="mailto:support@smartevents.com" class="font-semibold text-gray-900 hover:text-indigo-600">
                                support@smartevents.com
                            </a>
                        </div>
                    </div>
                    
                    <!-- Phone -->
                    <div class="flex gap-4">
                        <div class="text-indigo-600 text-xl flex-shrink-0 mt-1">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Phone</p>
                            <a href="tel:+27123456789" class="font-semibold text-gray-900 hover:text-indigo-600">
                                +27 (123) 456-789
                            </a>
                        </div>
                    </div>
                    
                    <!-- Address -->
                    <div class="flex gap-4">
                        <div class="text-indigo-600 text-xl flex-shrink-0 mt-1">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Address</p>
                            <p class="font-semibold text-gray-900">
                                123 Event Street<br>
                                Cape Town, WC 8001<br>
                                South Africa
                            </p>
                        </div>
                    </div>
                    
                    <!-- Business Hours -->
                    <div class="flex gap-4">
                        <div class="text-indigo-600 text-xl flex-shrink-0 mt-1">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Business Hours</p>
                            <p class="font-semibold text-gray-900">
                                Mon - Fri: 9:00 AM - 5:00 PM<br>
                                Sat: 10:00 AM - 3:00 PM<br>
                                Sun: Closed
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- FAQ Card -->
            <div class="bg-indigo-50 rounded-lg p-6 border border-indigo-200">
                <h3 class="text-lg font-semibold text-indigo-900 mb-4">FAQ</h3>
                <ul class="space-y-3 text-sm">
                    <li>
                        <a href="/faq#booking" class="text-indigo-700 hover:text-indigo-900 font-medium">
                            How do I book tickets?
                        </a>
                    </li>
                    <li>
                        <a href="/faq#refund" class="text-indigo-700 hover:text-indigo-900 font-medium">
                            What's your refund policy?
                        </a>
                    </li>
                    <li>
                        <a href="/faq#changes" class="text-indigo-700 hover:text-indigo-900 font-medium">
                            Can I change my booking?
                        </a>
                    </li>
                    <li>
                        <a href="/faq#cancelled" class="text-indigo-700 hover:text-indigo-900 font-medium">
                            What if an event is cancelled?
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    
    <!-- Form Validation Script -->
    <script>
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            let isValid = true;
            
            // Clear previous errors
            document.querySelectorAll('[id$="Error"]').forEach(el => {
                el.classList.add('hidden');
            });
            
            // Validate name
            const name = document.getElementById('name').value.trim();
            if (!name) {
                showError('nameError', 'Name is required');
                isValid = false;
            } else if (name.length < 2) {
                showError('nameError', 'Name must be at least 2 characters');
                isValid = false;
            }
            
            // Validate email
            const email = document.getElementById('email').value.trim();
            if (!email) {
                showError('emailError', 'Email is required');
                isValid = false;
            } else if (!isValidEmail(email)) {
                showError('emailError', 'Please enter a valid email');
                isValid = false;
            }
            
            // Validate phone
            const phone = document.getElementById('phone').value.trim();
            if (!phone) {
                showError('phoneError', 'Phone is required');
                isValid = false;
            } else if (!/^[\d\s\-\+\(\)]+$/.test(phone) || phone.replace(/\D/g, '').length < 10) {
                showError('phoneError', 'Please enter a valid phone number');
                isValid = false;
            }
            
            // Validate subject
            const subject = document.getElementById('subject').value;
            if (!subject) {
                showError('subjectError', 'Please select a subject');
                isValid = false;
            }
            
            // Validate message
            const message = document.getElementById('message').value.trim();
            if (!message) {
                showError('messageError', 'Message is required');
                isValid = false;
            } else if (message.length < 10) {
                showError('messageError', 'Message must be at least 10 characters');
                isValid = false;
            }
            
            if (!isValid) {
                e.preventDefault();
            } else {
                // Show loading state
                document.getElementById('submitBtn').disabled = true;
                document.getElementById('btnText').textContent = 'Sending...';
                document.getElementById('btnSpinner').classList.remove('hidden');
            }
        });
        
        function showError(elementId, message) {
            const element = document.getElementById(elementId);
            if (element) {
                element.textContent = message;
                element.classList.remove('hidden');
            }
        }
        
        function isValidEmail(email) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }
    </script>
    
<% } %>
