<!-- Event Details Page -->

<% if (typeof event !== 'undefined' && event) { %>
    <!-- Navigation -->
    <nav class="mb-6 flex items-center space-x-2 text-sm">
        <a href="/" class="text-indigo-600 hover:text-indigo-700">Home</a>
        <i class="fas fa-chevron-right text-gray-400"></i>
        <a href="/?category=<%= event.category %>" class="text-indigo-600 hover:text-indigo-700 capitalize"><%= event.category %></a>
        <i class="fas fa-chevron-right text-gray-400"></i>
        <span class="text-gray-600"><%= event.title %></span>
    </nav>
    
    <!-- Hero Image Section -->
    <div class="mb-8 rounded-lg overflow-hidden shadow-lg h-96 bg-gray-200">
        <img 
            src="<%= event.imageUrl || '/images/placeholders/event-placeholder.jpg' %>"
            alt="<%= event.title %>"
            class="w-full h-full object-cover"
        >
    </div>
    
    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column - Event Information -->
        <div class="lg:col-span-2">
            <!-- Event Header -->
            <div class="mb-8">
                <div class="flex items-start justify-between mb-4">
                    <div>
                        <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= event.title %></h1>
                        <div class="flex items-center gap-4 text-gray-600">
                            <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm font-semibold capitalize">
                                <%= event.category %>
                            </span>
                        </div>
                    </div>
                </div>

                <% if (event.price && event.price > 0) { %>
                    <div class="text-3xl font-bold text-indigo-600 mb-4">
                        R<%= event.price.toFixed(2) %> <span class="text-base text-gray-600">per ticket</span>
                    </div>
                <% } else { %>
                    <div class="text-3xl font-bold text-green-600 mb-4">
                        FREE
                    </div>
                <% } %>
            </div>
            
            <!-- Event Details Tabs -->
            <div class="mb-8 border-b border-gray-200">
                <div class="flex gap-8 mb-6" id="detailsTabs">
                    <button class="tab-btn font-semibold text-indigo-600 border-b-2 border-indigo-600 pb-2" data-tab="overview">
                        Overview
                    </button>
                    <button class="tab-btn font-semibold text-gray-600 pb-2" data-tab="details">
                        Details
                    </button>
                    <button class="tab-btn font-semibold text-gray-600 pb-2" data-tab="location">
                        Location
                    </button>
                </div>
            </div>
            
            <!-- Overview Tab -->
            <div id="overview" class="tab-content mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">About This Event</h2>
                <div class="prose max-w-none text-gray-700 leading-relaxed mb-6">
                    <%= event.description %>
                </div>
                
                <!-- Quick Facts -->
                <div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Facts</h3>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                        <div>
                            <p class="text-gray-600 text-sm mb-1">Capacity</p>
                            <p class="font-semibold text-gray-900"><%= event.capacity %> people</p>
                        </div>
                        <div>
                            <p class="text-gray-600 text-sm mb-1">Tickets Available</p>
                            <p class="font-semibold text-gray-900"><%= event.ticketsAvailable %> / <%= event.capacity %></p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Details Tab -->
            <div id="details" class="tab-content mb-8 hidden">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Event Details</h2>
                
                <div class="space-y-4">
                    <div class="flex items-start gap-4 pb-4 border-b border-gray-200">
                        <i class="fas fa-calendar-alt text-indigo-600 mt-1 text-lg"></i>
                        <div>
                            <p class="text-gray-600 text-sm">Event Date & Time</p>
                            <p class="font-semibold text-gray-900">
                                <%= new Date(event.date).toLocaleDateString('en-ZA', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %>
                            </p>
                            <p class="text-gray-600">
                                <%= new Date(event.date).toLocaleTimeString('en-ZA', { hour: '2-digit', minute: '2-digit' }) %>
                            </p>
                        </div>
                    </div>
                    
                    <div class="flex items-start gap-4 pb-4 border-b border-gray-200">
                        <i class="fas fa-map-marker-alt text-indigo-600 mt-1 text-lg"></i>
                        <div>
                            <p class="text-gray-600 text-sm">Venue</p>
                            <p class="font-semibold text-gray-900"><%= event.location %></p>
                            <p class="text-gray-600 text-sm"><%= event.venueName || 'Venue' %></p>
                        </div>
                    </div>
                    
                    <div class="flex items-start gap-4 pb-4 border-b border-gray-200">
                        <i class="fas fa-user-tie text-indigo-600 mt-1 text-lg"></i>
                        <div>
                            <p class="text-gray-600 text-sm">Organizer</p>
                            <p class="font-semibold text-gray-900"><%= event.organizer || 'Event Organizer' %></p>
                            <p class="text-gray-600 text-sm"><%= event.organizerContact || 'Contact available at event' %></p>
                        </div>
                    </div>
                    
                    <% if (event.speakers && event.speakers.length > 0) { %>
                        <div class="flex items-start gap-4 pb-4 border-b border-gray-200">
                            <i class="fas fa-microphone text-indigo-600 mt-1 text-lg"></i>
                            <div>
                                <p class="text-gray-600 text-sm">Speakers</p>
                                <ul class="space-y-1 mt-2">
                                    <% event.speakers.forEach(speaker => { %>
                                        <li class="font-semibold text-gray-900"><%= speaker %></li>
                                    <% }); %>
                                </ul>
                            </div>
                        </div>
                    <% } %>
                    
                    <% if (event.tags && event.tags.length > 0) { %>
                        <div class="flex items-start gap-4 pb-4">
                            <i class="fas fa-tags text-indigo-600 mt-1 text-lg"></i>
                            <div>
                                <p class="text-gray-600 text-sm mb-2">Tags</p>
                                <div class="flex flex-wrap gap-2">
                                    <% event.tags.forEach(tag => { %>
                                        <span class="px-3 py-1 bg-gray-200 text-gray-700 rounded-full text-sm">
                                            #<%= tag %>
                                        </span>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Location Tab -->
            <div id="location" class="tab-content hidden">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Location</h2>
                <div class="bg-gray-200 rounded-lg p-2 mb-4">
                    <div id="map" class="rounded-lg h-96 w-full"></div>
                </div>
                <div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
                    <p class="text-lg font-semibold text-gray-900 mb-2"><%= event.location %></p>
                    <p class="text-gray-600 mb-4"><%= event.venueName || 'Event Venue' %></p>
                    <p class="text-gray-600">
                        <i class="fas fa-phone mr-2"></i>
                        <%= event.venuePhone || 'Contact available at event' %>
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Right Column - Booking Card -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-lg border border-gray-200 p-6 sticky top-24">
                
                <!-- Availability Status -->
                <div class="mb-6">
                    <p class="text-gray-600 text-sm mb-2">Availability</p>
                    <% if (event.ticketsAvailable > 0) { %>
                        <div class="flex items-center gap-2 mb-3">
                            <span class="inline-block w-3 h-3 bg-green-600 rounded-full"></span>
                            <span class="font-semibold text-green-600">
                                <%= event.ticketsAvailable %> seats available
                            </span>
                        </div>
                    <% } else { %>
                        <div class="flex items-center gap-2 mb-3">
                            <span class="inline-block w-3 h-3 bg-red-600 rounded-full"></span>
                            <span class="font-semibold text-red-600">Sold Out</span>
                        </div>
                    <% } %>
                    
                    <!-- Progress Bar -->
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div 
                            class="<%= event.ticketsAvailable > 0 ? 'bg-indigo-600' : 'bg-red-600' %> h-2 rounded-full transition-all"
                            style="width: <%= (event.ticketsAvailable / event.capacity) * 100 %>%"
                        ></div>
                    </div>
                </div>
                
                <!-- Booking Button -->
                <% if (event.ticketsAvailable > 0) { %>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <form action="/bookings/<%= event._id %>" method="POST">
                            <!-- Quantity Selector -->
                            <div class="mb-6">
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    Number of Tickets
                                </label>
                                <div class="flex items-center border border-gray-300 rounded-lg">
                                    <button type="button" class="qty-btn px-4 py-2" data-action="decrease">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input 
                                        type="number"
                                        id="quantity"
                                        name="quantity"
                                        value="1"
                                        min="1"
                                        max="<%= event.ticketsAvailable %>"
                                        class="flex-1 px-4 py-2 text-center"
                                    >
                                    <button type="button" class="qty-btn px-4 py-2" data-action="increase">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Booking Button -->
                            <button
                                type="submit"
                                class="w-full bg-indigo-600 text-white py-3 rounded-lg font-semibold
                                hover:bg-indigo-700 transition-all"
                            >
                                Book Now
                            </button>
                        </form>
                    <% } else { %>
                        <a 
                            href="/auth/login"
                            class="w-full bg-indigo-600 text-white py-3 rounded-lg font-semibold 
                                   hover:bg-indigo-700 transition-colors 
                                   text-center mb-3 block"
                        >
                            <i class="fas fa-sign-in-alt mr-2"></i>Login to Book
                        </a>
                    <% } %>
                <% } else { %>
                    <button 
                        disabled
                        class="w-full bg-gray-300 text-gray-600 py-3 rounded-lg font-semibold cursor-not-allowed mb-3"
                    >
                        <i class="fas fa-ban mr-2"></i>Sold Out
                    </button>
                <% } %>

                <!-- Important Note -->
                <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                    <p class="text-sm text-blue-800">
                        <i class="fas fa-info-circle mr-2"></i>
                        <span class="font-medium">Pro tip:</span> Book early for better seat selection and exclusive discounts.
                    </p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Related Events Section -->
    <% if (typeof relatedEvents !== 'undefined' && relatedEvents.length > 0) { %>
        <div class="mt-16 pt-8 border-t border-gray-200">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Related Events</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% relatedEvents.slice(0, 3).forEach(relEvent => { %>
                    <%- include('../partials/event-card', { event: relEvent }) %>
                <% }); %>
            </div>
        </div>
    <% } %>
    
    <script>
        // Tab switching
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const tabName = this.getAttribute('data-tab');
                
                // Hide all tabs
                document.querySelectorAll('.tab-content').forEach(tab => {
                    tab.classList.add('hidden');
                });
                
                // Remove active state from all buttons
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('text-indigo-600', 'border-b-2', 'border-indigo-600');
                    b.classList.add('text-gray-600');
                });
                
                // Show selected tab
                document.getElementById(tabName).classList.remove('hidden');
                
                // Add active state to clicked button
                this.classList.remove('text-gray-600');
                this.classList.add('text-indigo-600', 'border-b-2', 'border-indigo-600');
            });
        });
        
        // Quantity buttons
        document.querySelectorAll('.qty-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = document.getElementById('quantity');
                const currentValue = parseInt(input.value);
                const max = parseInt(input.max);
                
                if (this.getAttribute('data-action') === 'increase' && currentValue < max) {
                    input.value = currentValue + 1;
                } else if (this.getAttribute('data-action') === 'decrease' && currentValue > 1) {
                    input.value = currentValue - 1;
                }
            });
        });
    </script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

    <style>
        .leaflet-container {
            z-index: 1 !important;
        }

        .leaflet-pane,
        .leaflet-top,
        .leaflet-bottom,
        .leaflet-control {
            z-index: 1 !important;
        }
    </style>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        (function () {
        const locationText = "<%= event.location %>";

        if (!locationText) return;

        let lat = -33.9249;
        let lng = 18.4241;

        const map = L.map('map').setView([lat, lng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationText)}&limit=1&addressdetails=1&countrycodes=za`)
            .then(res => res.json())
            .then(data => {
                if (data && data.length > 0) {
                    lat = parseFloat(data[0].lat);
                    lng = parseFloat(data[0].lon);

                    map.setView([lat, lng], 14);

                    L.marker([lat, lng])
                        .addTo(map)
                        .bindPopup(locationText)
                        .openPopup();
                } else {
                    L.marker([lat, lng])
                        .addTo(map)
                        .bindPopup("Location not found")
                        .openPopup();
                }
            })
            .catch(() => {
                L.marker([lat, lng])
                    .addTo(map)
                    .bindPopup(locationText)
                    .openPopup();
            });
        })();
    </script>

<% } else { %>
    <!-- Event Not Found -->
    <div class="text-center py-16">
        <i class="fas fa-calendar-times text-6xl text-gray-400 mb-4"></i>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Event Not Found</h1>
        <p class="text-gray-600 mb-6">The event you're looking for doesn't exist or has been removed.</p>
        <a href="/" class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>Back to Events
        </a>
    </div>
<% } %>
