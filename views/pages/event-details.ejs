<!-- Hero Section -->
<section class="relative h-[400px] md:h-[500px] w-full">
  <img 
    src="<%= event.imageUrl || '/images/placeholders/event-placeholder.jpg' %>" 
    alt="<%= event.title %>"
    class="w-full h-full object-cover"
  >
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
  
  <div class="absolute bottom-0 left-0 w-full pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="bg-primary text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
          <%= event.category %>
        </span>
        <span class="bg-white/20 backdrop-blur-md text-white px-3 py-1 rounded-full text-xs font-medium">
          <i class="fas fa-eye mr-1"></i> 1.2k Views
        </span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4"><%= event.title %></h1>
      <div class="flex flex-wrap items-center text-primary-100 gap-6 text-sm md:text-base">
        <div class="flex items-center"><i class="fas fa-calendar-alt mr-2 text-accent"></i> <%= new Date(event.date).toLocaleDateString(undefined, { dateStyle: 'full' }) %></div>
        <div class="flex items-center"><i class="fas fa-map-marker-alt mr-2 text-accent"></i> <%= event.location %></div>
      </div>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
    
    <!-- Left Column: Details -->
    <div class="lg:col-span-2 space-y-10">
      <!-- Description -->
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">About This Event</h2>
        <div class="text-gray-600 leading-relaxed space-y-4">
          <p><%= event.description %></p>
        </div>
      </div>

      <!-- Features/Inclusions -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 flex items-center">
          <div class="w-10 h-10 rounded-full bg-primary-100 text-primary flex items-center justify-center mr-4">
            <i class="fas fa-certificate"></i>
          </div>
          <span class="font-medium text-gray-700">Certificate of Attendance</span>
        </div>
        <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 flex items-center">
          <div class="w-10 h-10 rounded-full bg-primary-100 text-primary flex items-center justify-center mr-4">
            <i class="fas fa-utensils"></i>
          </div>
          <span class="font-medium text-gray-700">Lunch & Refreshments</span>
        </div>
      </div>

      <!-- Organizer Info -->
      <div class="pt-8 border-t border-gray-100">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Organized By</h3>
        <div class="flex items-center">
          <div class="w-12 h-12 rounded-full bg-gray-200 mr-4"></div>
          <div>
            <p class="font-bold text-gray-900">Smart Events Team</p>
            <p class="text-sm text-gray-500">Verified Organizer</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Booking Sidebar -->
    <div class="lg:col-span-1">
      <div class="sticky top-24 bg-white rounded-2xl shadow-xl border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-6">
          <span class="text-gray-500 font-medium">Ticket Price</span>
          <span class="text-3xl font-bold text-primary">$<%= event.price %></span>
        </div>

        <div class="space-y-4 mb-6">
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Availability</span>
            <span class="font-bold text-success"><%= event.availableTickets %> / <%= event.capacity %> left</span>
          </div>
          <div class="w-full bg-gray-100 h-2 rounded-full">
            <div class="bg-success h-2 rounded-full" style="--pct: <%= event.capacity > 0 ? ((event.availableTickets / event.capacity) * 100).toFixed(1) : 0 %>%; width: var(--pct)"></div>
          </div>
        </div>

        <form action="/bookings/checkout/<%= event._id %>" method="POST" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
            <select name="quantity" class="w-full border-gray-200 rounded-lg focus:ring-primary focus:border-primary">
              <% for(let i=1; i<=Math.min(5, event.availableTickets); i++) { %>
                <option value="<%= i %>"><%= i %> Ticket<%= i > 1 ? 's' : '' %></option>
              <% } %>
            </select>
          </div>

          <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white py-4 rounded-xl font-bold text-lg transition-all shadow-lg shadow-primary/20">
            Book Tickets Now
          </button>
        </form>

        <p class="text-center text-xs text-gray-400 mt-4">
          <i class="fas fa-lock mr-1"></i> Secure payment processed by Stripe
        </p>
      </div>
    </div>

  </div>
</section>