<!-- Admin Event Management Page -->

<% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
    <!-- Page Header -->
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Event Management</h1>
            <p class="text-gray-600">Create, edit, and manage all events on the platform.</p>
        </div>
        <a 
            href="/admin/events/create"
            class="inline-flex items-center gap-2 bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold
                   hover:bg-indigo-700 hover:text-white focus:text-white active:text-white
                   hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
        >
            <i class="fas fa-plus"></i>
            <span>Create Event</span>
        </a>
    </div>

    <!-- Filters & Search -->
    <div class="bg-white rounded-lg shadow p-6 mb-6 border border-gray-200">
        <form method="GET" class="flex gap-4 flex-wrap">
            <input 
                type="text"
                name="search"
                placeholder="Search events..."
                class="flex-1 min-w-xs px-4 py-2 border border-gray-300 rounded-lg 
                       focus:outline-none focus:ring-2 focus:ring-indigo-500"
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            >
            <select 
                name="status"
                class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none 
                       focus:ring-2 focus:ring-indigo-500"
            >
                <option value="">All Status</option>
                <option value="active" <% if (typeof filterStatus !== 'undefined' && filterStatus === 'active') { %>selected<% } %>>Active</option>
                <option value="draft" <% if (typeof filterStatus !== 'undefined' && filterStatus === 'draft') { %>selected<% } %>>Draft</option>
                <option value="cancelled" <% if (typeof filterStatus !== 'undefined' && filterStatus === 'cancelled') { %>selected<% } %>>Cancelled</option>
            </select>
            <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700 transition-colors">
                Filter
            </button>
        </form>
    </div>
    
    <!-- Events Table -->
    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <% if (typeof events !== 'undefined' && events.length > 0) { %>
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">Event Title</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">Date</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">Location</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">Capacity</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">Bookings</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">Status</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% events.forEach(event => { %>
                            <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-gray-900"><%= event.title %></div>
                                    <div class="text-sm text-gray-600 capitalize"><%= event.category %></div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">
                                    <%= new Date(event.date).toLocaleDateString('en-ZA') %>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">
                                    <%= event.location %>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">
                                    <%= event.capacity %>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">
                                    <div class="font-semibold"><%= event.capacity - event.ticketsAvailable %> / <%= event.capacity %></div>
                                    <div class="text-xs text-gray-600"><%= ((event.capacity - event.ticketsAvailable) / event.capacity * 100).toFixed(0) %>% filled</div>
                                </td>
                                <td class="px-6 py-4 text-sm">
                                    <%
                                        let status = 'active';
                                        let statusColor = 'green';

                                        const now = new Date();

                                        if (new Date(event.date) < now) {
                                            status = 'completed';
                                            statusColor = 'gray';
                                        } else if (event.ticketsAvailable <= 0) {
                                            status = 'sold out';
                                            statusColor = 'red';
                                        }
                                    %>

                                        <span class="inline-block px-3 py-1 bg-<%= statusColor %>-100 text-<%= statusColor %>-700 
                                                     rounded-full text-xs font-semibold capitalize">
                                            <%= status %>
                                        </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex gap-2">
                                        <a 
                                            href="/admin/events/<%= event._id %>/edit"
                                            class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-700 font-medium text-sm"
                                            title="Edit event"
                                        >
                                            <i class="fas fa-edit"></i>
                                            <span class="hidden sm:inline">Edit</span>
                                        </a>
                                        <a 
                                            href="/events/<%= event._id %>"
                                            class="inline-flex items-center gap-1 text-teal-600 hover:text-teal-700 font-medium text-sm"
                                            title="View event"
                                        >
                                            <i class="fas fa-eye"></i>
                                            <span class="hidden sm:inline">View</span>
                                        </a>
                                        <button 
                                            class="inline-flex items-center gap-1 text-red-600 hover:text-red-700 font-medium text-sm"
                                            onclick="deleteEvent('<%= event._id %>')"
                                            title="Delete event"
                                        >
                                            <i class="fas fa-trash"></i>
                                            <span class="hidden sm:inline">Delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="p-12 text-center">
                    <i class="fas fa-inbox text-6xl text-gray-400 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-gray-900 mb-2">No Events Found</h3>
                    <p class="text-gray-600 mb-6">Create your first event to get started.</p>
                    <a href="/admin/events/create" class="inline-block bg-indigo-600 text-white px-6 py-3 
                                                          rounded-lg font-semibold hover:bg-indigo-700 
                                                          transition-colors">
                        <i class="fas fa-plus mr-2"></i>Create Event
                    </a>
                </div>
            <% } %>
        </div>
    </div>
    
    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="flex justify-center items-center gap-2 mt-8">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <% if (i === (typeof currentPage !== 'undefined' ? currentPage : 1)) { %>
                    <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium">
                        <%= i %>
                    </button>
                <% } else { %>
                    <a 
                        href="?page=<%= i %>"
                        class="px-4 py-2 border border-gray-300 rounded-lg font-medium hover:bg-gray-50 transition-colors"
                    >
                        <%= i %>
                    </a>
                <% } %>
            <% } %>
        </div>
    <% } %>
    
    <script>
        function deleteEvent(eventId) {
            if (confirm('Are you sure you want to delete this event? This action cannot be undone.')) {
                fetch(`/admin/events/${eventId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Failed to delete event');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while deleting the event');
                });
            }
        }
    </script>

<% } else { %>
    <!-- Unauthorized Access -->
    <div class="text-center py-16">
        <i class="fas fa-lock text-6xl text-gray-400 mb-4"></i>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Access Denied</h1>
        <p class="text-gray-600 mb-6">You don't have permission to access this page. Admin access is required.</p>
        <a href="/" class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>Back to Home
        </a>
    </div>
<% } %>
