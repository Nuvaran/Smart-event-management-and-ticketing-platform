<!-- Admin Enquiries Page -->

<% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>

<div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">User Enquiries</h1>
        <p class="text-gray-600">View and respond to messages from users.</p>
    </div>

    <% if (enquiries && enquiries.length > 0) { %>
        <div class="space-y-4">
            <% enquiries.forEach(enquiry => { %>
                <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
                    <div class="flex justify-between items-start">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">
                                <%= enquiry.name %>
                            </h2>
                            <p class="text-sm text-gray-600">
                                <%= enquiry.email %>
                            </p>
                        </div>
                        <span class="px-3 py-1 text-xs rounded-full font-semibold
                            <%= enquiry.status === 'unread' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>">
                            <%= enquiry.status %>
                        </span>
                    </div>
                    <p class="mt-4 text-gray-700">
                        <%= enquiry.message %>
                    </p>
                    <div class="mt-4 text-xs text-gray-500">
                        <%= new Date(enquiry.submittedAt).toLocaleString('en-ZA') %>
                    </div>

                    <!-- Actions -->
                    <div class="mt-4 flex gap-2">
                        <form method="POST" action="/admin/enquiries/<%= enquiry._id %>/read">
                            <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-indigo-700">
                                Mark as Read
                            </button>
                        </form>
                        <form method="POST" action="/admin/enquiries/<%= enquiry._id %>/delete">
                            <button class="bg-red-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-red-700">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>

    <% } else { %>

        <div class="text-center py-16 bg-gray-50 rounded-lg border">
            <i class="fas fa-inbox text-5xl text-gray-400 mb-4"></i>
            <p class="text-gray-600">No enquiries found</p>
        </div>
    <% } %>
</div>

<% } else { %>

<div class="text-center py-16">
    <h1 class="text-2xl font-bold">Access Denied</h1>
</div>

<% } %>